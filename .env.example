# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Administrator Security (Must be strong and configured in server environment)
ADMIN_EMAIL="admin@gxacareeracademy.com"
ADMIN_PASSWORD=""
JWT_SECRET=""

# Razorpay Production / Sandbox Credentials (Optional during development preview)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# PayPal REST API Credentials (Optional during development preview)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox" # sandbox | live

# Production Webhooks (Optional during development; configure after custom HTTPS domain deployment)
# RAZORPAY_WEBHOOK_SECRET=""
# PAYPAL_WEBHOOK_ID=""

# NPCI UPI / Banking Switch Parameters
UPI_MERCHANT_VPA="gxatechnology@icici"

# Cryptographic Token Signatures
DOWNLOAD_TOKEN_SECRET=""
